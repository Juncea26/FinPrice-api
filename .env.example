# FinPrice API - Standalone Real Cloud API (Render + Neon Serverless)
# ==============================================================================
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Clave secreta para sincronización administrativa (POST /api/v1/collectors/sync)
FINPRICE_ADMIN_API_KEY=finprice_secret_admin_key_2026

# Orígenes CORS permitidos
ALLOWED_ORIGINS=*

# Base de datos en la nube (Neon PostgreSQL US East 2 - Ohio, Pooled)
DATABASE_URL=postgresql://neondb_owner:npg_VKNxQ6JF1IMR@ep-cool-math-b4z3cnnd-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Caché en memoria TTL (en segundos)
CACHE_TTL_SECONDS=60

# Intervalo del recolector automático en segundo plano (en minutos, 360 min = 6 horas)
COLLECTION_INTERVAL_MINUTES=360

# Configuración HTTP y concurrencia estricta (máximo 2 tiendas para < 300 MB RAM)
COLLECTOR_TIMEOUT_CONNECT=6.0
COLLECTOR_TIMEOUT_READ=12.0
COLLECTOR_MAX_CONCURRENCY=2
