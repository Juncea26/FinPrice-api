# FinPrice API - Configuración de Entorno en la Nube
# ========================================================
# Entorno de ejecución: "development" o "production"
ENVIRONMENT=development

# Red y Servidor
HOST=0.0.0.0
PORT=8000

# Clave secreta para sincronización administrativa (POST /api/v1/collectors/sync)
FINPRICE_ADMIN_API_KEY=finprice_secret_admin_key_2026

# Orígenes CORS permitidos (separados por coma o '*' en development)
ALLOWED_ORIGINS=*

# Base de datos persistente (SQLite por defecto para standalone, compatible con PostgreSQL)
DATABASE_URL=sqlite:///./finprice_cloud.db

# Caché en memoria TTL (en segundos)
CACHE_TTL_SECONDS=60

# Intervalo del recolector automático en segundo plano (en minutos, 360 min = 6 horas)
COLLECTION_INTERVAL_MINUTES=360

# Límites de Rate Limiting por IP (peticiones por minuto)
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=5

# Timeouts y concurrencia de recolectores (httpx async)
COLLECTOR_TIMEOUT_CONNECT=5.0
COLLECTOR_TIMEOUT_READ=10.0
COLLECTOR_MAX_CONCURRENCY=4
