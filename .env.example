# FinPrice API - Standalone Real Cloud API
# ========================================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Clave secreta para sincronización administrativa (POST /api/v1/collectors/sync)
FINPRICE_ADMIN_API_KEY=finprice_secret_admin_key_2026

# Orígenes CORS permitidos
ALLOWED_ORIGINS=*

# Base de datos asíncrona real (SQLite persistente por defecto o PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./finprice_real.db

# Caché en memoria TTL (en segundos)
CACHE_TTL_SECONDS=60

# Intervalo del recolector automático en segundo plano (en minutos, 360 min = 6 horas)
COLLECTION_INTERVAL_MINUTES=360

# Configuración HTTP y concurrencia de scraping
COLLECTOR_TIMEOUT_CONNECT=6.0
COLLECTOR_TIMEOUT_READ=12.0
COLLECTOR_MAX_CONCURRENCY=4
